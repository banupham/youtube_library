{
  "manifest_version": 3,
  "name": "YouTube Library Recommendation Collector",
  "version": "0.7.0",
  "description": "Read-only natural-use collector for Home, Up Next, Subscriptions and interaction events. It never clicks, plays, comments, likes or subscribes on behalf of the participant.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8770/*",
    "http://localhost:8770/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["passive_collector.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Library collector",
    "default_popup": "popup.html"
  }
}
